# Environment variables for `docker-compose up` (repo-root level).
# Copy to `.env` and adjust for your machine. Never commit `.env` with
# real values (see docs/SECURITY.md).

# --- Database ---
DATABASE_NAME=portfolio
DATABASE_USER=portfolio
DATABASE_PASSWORD=portfolio

# --- Django backend ---
# Generate a real one for anything beyond local dev:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-dev-only-do-not-use-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# "backend" is required here (not just localhost/127.0.0.1) because
# inside Docker, the frontend container's server-side fetches reach
# Django using the Compose service name "backend" as the Host header,
# not "localhost" — Django rejects any Host it doesn't recognize.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Next.js frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Used for sitemap.xml/robots.txt and Open Graph metadata. Set to the
# real production domain once deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact form email (Resend) ---
# Get a free API key at https://resend.com. Leave blank to run without
# email notifications — messages are still saved to the database either
# way (see docs/DECISIONS.md).
RESEND_API_KEY=
# Must match the email address on your Resend account UNLESS you've
# verified a custom domain — see backend/contact/email.py and
# docs/DECISIONS.md for why.
CONTACT_RECIPIENT_EMAIL=
RESEND_FROM_EMAIL=onboarding@resend.dev 
