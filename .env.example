# Environment variables for `docker-compose up` (repo-root level).
# Copy to `.env` and adjust for your machine. Never commit `.env` with
# real values (see docs/SECURITY.md).

# --- Database ---
DATABASE_NAME=portfolio
DATABASE_USER=portfolio
DATABASE_PASSWORD=portfolio

# --- Django backend ---
# Generate a real one for anything beyond local dev:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-dev-only-do-not-use-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Next.js frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
