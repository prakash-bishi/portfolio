# Environment variables for running the Django backend WITHOUT Docker.
# Copy to backend/.env. Never commit backend/.env with real values.

DJANGO_SECRET_KEY=django-insecure-dev-only-do-not-use-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Use sqlite for a quick local run without Postgres installed:
DATABASE_ENGINE=sqlite
# Or point at a real Postgres instance:
# DATABASE_ENGINE=postgresql
# DATABASE_NAME=portfolio
# DATABASE_USER=portfolio
# DATABASE_PASSWORD=portfolio
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
