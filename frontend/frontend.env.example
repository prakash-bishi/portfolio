# Environment variables for running the Next.js frontend WITHOUT Docker.
# Copy to frontend/.env.local. Never commit frontend/.env.local with real values.

# Used by code running in the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Used by code running on the server (e.g. Server Components). Outside
# Docker this is the same as the browser URL. Inside Docker Compose it
# must instead be the backend's service name (see docker-compose.yml,
# which sets this automatically to http://backend:8000 — you don't need
# to set it yourself when running via Docker).
INTERNAL_API_BASE_URL=http://localhost:8000
